---
title: search
layout: none
search: exclude
---
{% assign docs = site.pages | where_exp: "p", "p.url contains '/docs/'" | where_exp: "p", "p.search != 'exclude'" %}
[
{% for page in docs %}
{
"title": "{{ page.title | escape }}",
"tags": "{{ page.tags }}",
"keywords": "{{page.keywords}}",
"url": "{{ page.url | remove_first: "/docs/" }}",
"summary": "{{page.summary | strip }}"
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
